				<true/>
				<key>Path</key>
				<string>SSDT-PMC.aml</string>
			</dict>
			<dict>
				<key>Comment</key>
				<string>SSDT-GPRW-XDCI - anti instant-wake hotpatch: rewrites _PRW GPE 0x0D/0x6D to 0 (XDCI). REQUIRES the _PRW-&gt;XPRW rename patch below. Verify against the real DSDT on the machine; if no _PRW matches it is a harmless no-op. Source .dsl sits next to the .aml.</string>
				<key>Enabled</key>
				<true/>
				<key>Path</key>
				<string>SSDT-GPRW-XDCI.aml</string>
			</dict>
		</array>
